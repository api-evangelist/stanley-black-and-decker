  "info": {
    "_postman_id": "819c6d33-0076-4f8d-8acd-3aa3a26dee49",
    "name": "Stanley Black & Decker Tool Connect Assets Jobsites API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Stanley Black & Decker Tool Connect API enables partner integration with DEWALT's connected tool management platform. Partners can access tool inventory, track Bluetooth-connected tools and batteries, manage jobsite assets, and synchronize tool usage data. Used by fleet management software, construction platforms, and enterprise tool management solutions.\n\nContact Support:\n Name: DEWALT Developer Support",
      "type": "text/plain"
    }
  }
